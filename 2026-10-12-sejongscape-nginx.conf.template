# Replace PUBLIC_IP only after attaching a stable Lightsail public IPv4 address.
# Issue a public IP certificate first; this template is not installed automatically.
server {
    listen 80;
    server_name PUBLIC_IP;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sejongscape-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://PUBLIC_IP$request_uri; }
}
server {
    listen 443 ssl;
    server_name PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/PUBLIC_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PUBLIC_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 16k;
    # Never expose files directly: every route passes through the password gate.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host PUBLIC_IP;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header OAI-Authenticated-User-Id "";
        proxy_set_header OAI-Authenticated-User-Email "";
        proxy_set_header OAI-Authenticated-User-Full-Name "";
        proxy_read_timeout 30s;
    }
}
